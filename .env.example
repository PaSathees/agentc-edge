# Copy to .env (cp .env.example .env). .env is gitignored: never commit it.
# Secrets, and the few settings Docker Compose also needs. The rest lives in config.toml.

# How your phone reaches the hub: its home address (agentc find prints it), or its
# Tailscale address (tailscale ip -4) to answer away from home. Empty: no messages.
AGENTC_HUB=

# Anthropic API key, from console.anthropic.com > API keys. Optional: without it you get
# readings, signals and notices, but the housemate does not look into them.
# Tests and CI never use it: they use a fake model.
ANTHROPIC_API_KEY=

# Who may open the web pages. Either one, or both. With neither, the pages are open and
# shadow mode stays on, so nothing is written to a plug.
# AGENTC_TAILSCALE_USER: your Tailscale login (tailscale status --json shows it as
# LoginName), when you open the hub through Tailscale Serve. Several: comma-separated.
# AGENTC_PASSWORD: a password for the login page, e.g. from: openssl rand -base64 18
AGENTC_TAILSCALE_USER=
AGENTC_PASSWORD=

# Optional. Other names the hub is reached by (it answers its own IP addresses, localhost
# and the name in AGENTC_HUB). Comma-separated.
# AGENTC_HOSTS=edge-hub.local

# Optional. Where the data folder is (default ./data), and your user and group ids if
# `id -u` is not 1000, so the files in it stay yours.
# AGENTC_DATA_DIR=/data
# AGENTC_UID=1000
# AGENTC_GID=1000

# Optional, rarely needed. The ntfy topic (default: made from the secret, hard to guess),
# the key that signs buttons (default: data/secret, made on first start), and where the
# app publishes to ntfy (default: the ntfy service in compose).
# AGENTC_TOPIC=
# AGENTC_SECRET=
# AGENTC_NTFY_URL=http://127.0.0.1:8090
