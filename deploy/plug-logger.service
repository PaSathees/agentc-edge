[Unit]
Description=Plug energy logger
RequiresMountsFor=/data
Wants=network-online.target
After=network-online.target

[Service]
User=sathees
ExecStart=/usr/bin/python3 -u /home/sathees/logger/logger.py /data/energy.db /home/sathees/logger/config.toml
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target data.mount
